{
  "name": "svg-tools",
  "displayName": "SVG Explorer & Outline",
  "description": "SVG file badges and a source-aware native SVG outline.",
  "publisher": "svg-editor-lab",
  "version": "0.1.1",
  "type": "module",
  "private": true,
  "license": "UNLICENSED",
  "engines": { "vscode": "^1.96.0" },
  "categories": ["Other"],
  "activationEvents": ["onStartupFinished"],
  "contributes": {
    "configurationDefaults": {
      "workbench.editorAssociations": {
        "*.[sS][vV][gG]": "default"
      }
    }
  },
  "main": "./dist/extension.cjs",
  "scripts": { "vscode:prepublish": "node ../../scripts/build-extension.mjs" }
}

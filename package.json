{
  "name": "svg-editor-cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/clean.mjs && tsc -p tsconfig.build.json",
    "cli": "node dist/bootstrap/entry.js",
    "check": "pnpm run typecheck && pnpm run test && pnpm run build",
    "start": "node dist/bootstrap/entry.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "saxes": "^6.0.0"
  }
}

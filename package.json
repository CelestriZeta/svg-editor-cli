{
  "name": "svg-editor-cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/clean.mjs && tsc -p tsconfig.build.json && node scripts/copy-plugin-manifests.mjs",
    "cli": "node dist/bootstrap/entry.js",
    "check": "pnpm run typecheck && pnpm run test && pnpm run build && pnpm run check:extension",
    "build:extension": "node scripts/build-extension.mjs",
    "check:extension": "pnpm run typecheck:extension && pnpm run test:extension && pnpm run build:extension",
    "package:extension": "node scripts/package-extension.mjs",
    "test:extension": "vitest run --config extensions/svg-tools/vitest.config.ts",
    "test:extension:host": "node scripts/build-extension.mjs --tests && node scripts/test-extension-host.mjs",
    "typecheck:extension": "tsc -p extensions/svg-tools/tsconfig.json",
    "start": "node dist/bootstrap/entry.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/vscode": "1.96.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.1",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "saxes": "^6.0.0"
  }
}

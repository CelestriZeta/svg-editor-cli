{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "SVG Tools: Extension Host",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/extensions/svg-tools",
        "--disable-extensions",
        "${workspaceFolder}/extensions/svg-tools/examples"
      ],
      "outFiles": ["${workspaceFolder}/extensions/svg-tools/dist/**/*.cjs"],
      "preLaunchTask": "Build SVG extension"
    }
  ]
}
